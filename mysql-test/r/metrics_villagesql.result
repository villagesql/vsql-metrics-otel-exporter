INSTALL EXTENSION vsql_metrics_otel_exporter;
# VillageSQL collection defaults to on.
SELECT VARIABLE_VALUE AS villagesql_default
FROM performance_schema.global_variables
WHERE VARIABLE_NAME = 'vsql_metrics_otel_exporter.collect_villagesql';
villagesql_default
ON
SET GLOBAL vsql_metrics_otel_exporter.scrape_enabled = ON;
# The exporter's own worker is a VEF worker thread the collector counts.
SELECT COUNT(*) > 0 AS has_vef_worker FROM performance_schema.threads
WHERE name LIKE '%vef_extension_worker%';
has_vef_worker
1
SET GLOBAL vsql_metrics_otel_exporter.scrape_enabled = OFF;
# Worker count, pending errors, and per-extension info are exported (1 each).
1
1
1
# Nothing is pending an install or upgrade on this server.
SELECT COUNT(*) AS pending_errors FROM information_schema.extensions
WHERE pending_last_error IS NOT NULL;
pending_errors
0
#
# Switched off, the villagesql metrics disappear.
SET GLOBAL vsql_metrics_otel_exporter.scrape_enabled = ON;
SET GLOBAL vsql_metrics_otel_exporter.scrape_enabled = OFF;
0
#
# Nothing errored in either phase.
SELECT VARIABLE_VALUE = 0 AS no_scrape_errors FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'vsql_metrics_otel_exporter.scrape_errors_total';
no_scrape_errors
1
UNINSTALL EXTENSION vsql_metrics_otel_exporter;
